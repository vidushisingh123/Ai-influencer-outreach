# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional: also look for a public contact email on the creator's own website
# (honours robots.txt, fetches only the homepage and /contact). 1 = on, 0 = off.
ENRICH_FROM_WEBSITE=0

# Identifies this tool when fetching websites. Put your real contact address here.
BOT_USER_AGENT=EDXSO-OutreachBot/0.1 (assignment prototype; contact: you@example.com)

# Where outputs and the API response cache are written.
DATA_DIR=data

# --- Phase 2: AI message generation ---
# Groq API key (https://console.groq.com/keys). Never commit this file.
GROQ_API_KEY=
# Model ID; leave empty for the default (llama-3.3-70b-versatile). Verify availability first (see README).
GROQ_MODEL=
# Sender identity used in every message (BRAND_NAME and SENDER_NAME are required)
BRAND_NAME=
SENDER_NAME=
# One factual line about the brand/offer. The model may only use facts given here.
BRAND_DESCRIPTION=
COLLAB_TYPE=UGC content creation

# --- Phase 3: storage, sending, dashboard ---
DB_PATH=data/outreach.db
API_URL=http://127.0.0.1:8000
# Email mode. "simulation" (default) never sends anything. "smtp" sends REAL emails and needs every SMTP_* value below.
EMAIL_MODE=simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional text appended to REAL emails only (opt-out line, postal address, etc.)
EMAIL_FOOTER=

# --- Phase 3: database, API, dashboard, sending ---
DB_PATH=data/outreach.db
API_URL=http://127.0.0.1:8000
# simulation (default, nothing is sent) or smtp (REAL emails; also needs the SMTP_* values below)
EMAIL_MODE=simulation
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional text appended to real emails (e.g. opt-out line and postal address). Not appended in simulation.
EMAIL_FOOTER=
